  "components": {
    "schemas": {
      "Analysis": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "crawling",
              "processing",
              "embedding",
              "projecting",
              "done",
              "error",
              "cancelled"
            ],
            "title": "Status"
          },
          "progress": {
            "type": "integer",
            "title": "Progress"
          },
          "stage_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage Detail"
          },
          "article_count": {
            "type": "integer",
            "title": "Article Count"
          },
          "error_msg": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Msg"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning"
          },
          "created_ts": {
            "type": "integer",
            "title": "Created Ts"
          },
          "updated_ts": {
            "type": "integer",
            "title": "Updated Ts"
          }
        },
        "type": "object",
        "required": [
          "id",
          "topic",
          "status",
          "progress",
          "stage_detail",
          "article_count",
          "error_msg",
          "warning",
          "created_ts",
          "updated_ts"
        ],
        "title": "Analysis"
      },
      "AnalysisCreate": {
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Topic"
          }
        },
        "type": "object",
        "required": [
          "topic"
        ],
        "title": "AnalysisCreate"
      },
      "AnalysisEvent": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "ts": {
            "type": "integer",
            "title": "Ts"
          },
          "kind": {
            "type": "string",
            "enum": [
              "stage",
              "query",
              "article",
              "skip",
              "cluster",
              "warning",
              "error"
            ],
            "title": "Kind"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "ts",
          "kind",
          "message",
          "url"
        ],
        "title": "AnalysisEvent"
      },
      "Article": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "publish_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Publish Date"
          },
          "crawl_ts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crawl Ts"
          },
          "word_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Word Count"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "raw_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Text"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "analysis_id",
          "url",
          "domain",
          "title",
          "publish_date",
          "crawl_ts",
          "word_count",
          "language",
          "raw_text",
          "status"
        ],
        "title": "Article"
      },
      "ChatRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "citations"
        ],
        "title": "ChatResponse"
      },
      "Citation": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          }
        },
        "type": "object",
        "required": [
          "url",
          "title",
          "domain"
        ],
        "title": "Citation"
      },
      "Cluster": {
        "properties": {
          "cluster_id": {
            "type": "integer",
            "title": "Cluster Id"
          },
          "cluster_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cluster Label"
          },
          "article_count": {
            "type": "integer",
            "title": "Article Count"
          }
        },
        "type": "object",
        "required": [
          "cluster_id",
          "cluster_label",
          "article_count"
        ],
        "title": "Cluster"
      },
      "CorpusPoint": {
        "properties": {
