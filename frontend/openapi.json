    "/api/analyses/{analysis_id}/plan/approve": {
      "post": {
        "summary": "Approve Plan",
        "description": "Continue the paused analysis with the chosen pages (search results or your own URLs).",
        "operationId": "approve_plan",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
