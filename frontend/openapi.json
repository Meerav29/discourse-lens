            "title": "Chunk Id"
          },
          "cluster_id": {
            "type": "integer",
            "title": "Cluster Id"
          },
          "cluster_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cluster Label"
          },
          "distance_from_centroid": {
            "type": "number",
            "title": "Distance From Centroid"
          },
          "article_id": {
            "type": "string",
