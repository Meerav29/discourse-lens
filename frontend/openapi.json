    "/api/analyses/{analysis_id}/events": {
      "get": {
        "summary": "Get Events",
        "operationId": "get_events",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AnalysisEvent"
                  },
                  "title": "Response Get Events"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses/{analysis_id}/stream": {
      "get": {
        "summary": "Stream Analysis",
        "description": "Server-sent events until the analysis stops running:\n  default `message` events \u2014 the Analysis row, whenever it changes\n  `log` events (with `id:`) \u2014 new rows from the event log; EventSource\n  resends Last-Event-ID on reconnect, so the log resumes where it left off.",
        "operationId": "stream_analysis",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          },
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses/{analysis_id}/articles": {
      "get": {
        "summary": "List Articles",
        "description": "Every article on the map, with its position, topic and outlier score.",
        "operationId": "list_articles",
        "parameters": [
