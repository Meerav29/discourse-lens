# Required
BRAVE_API_KEY=your_key_here

# Claude backend — choose one: anthropic | vertex
CLAUDE_BACKEND=anthropic

# Anthropic API (used when CLAUDE_BACKEND=anthropic)
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-5-5  # override default model

# Vertex AI (used when CLAUDE_BACKEND=vertex)
# Prerequisites: uv sync --extra vertex  &&  gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
VERTEX_REGION=global            # global, a multi-region (us / eu), or a specific region
VERTEX_CLAUDE_MODEL=claude-sonnet-5-5  # override Vertex model

# Embeddings — choose one mode
EMBEDDING_MODE=fastembed        # fastembed (in-process) | ollama | openai
FASTEMBED_CACHE=./data/models   # where fastembed keeps its model (~520 MB)
OLLAMA_BASE_URL=http://localhost:11434  # only needed if EMBEDDING_MODE=ollama
OPENAI_API_KEY=your_key_here    # only needed if EMBEDDING_MODE=openai

# Storage paths
DB_PATH=./data/discourse.db
LANCE_PATH=./data/vectors

# Optional tuning
MAX_ARTICLES=120                # cap on total articles to crawl
UMAP_N_NEIGHBORS=15
KMEANS_K=auto                   # auto | integer (e.g. 7)
RAG_TOP_K=15
CHAT_EFFORT=medium             # low | medium | high: reasoning before chat answers
RECOVER_ACADEMIC=true         # look up open-access copies of pages academic publishers block
SEARCH_PROVIDER=brave         # brave | searxng
SEARXNG_URL=                  # e.g. http://localhost:8888 when SEARCH_PROVIDER=searxng
